# Copy to .env.local for development. Never commit real secrets.

# Explicit local mode runs hermetic development adapters only.
PAGE2WEBMCP_PROVIDER_MODE=local
PAGE2WEBMCP_FIXTURE_APP_URL=https://acme.example
PAGE2WEBMCP_FIXTURE_GITHUB_URL=https://github.com/acme/support
PAGE2WEBMCP_CONTROL_PLANE_URL=http://127.0.0.1:3100
PAGE2WEBMCP_CONTROL_PLANE_PUBLIC_ORIGIN=http://127.0.0.1:3100
PAGE2WEBMCP_DEMO_FIXTURE_URL=http://127.0.0.1:3200
PAGE2WEBMCP_ACME_PUBLIC_ORIGIN=http://127.0.0.1:3200

# Production GitHub mode fails startup closed unless every control is present.
# PAGE2WEBMCP_PROVIDER_MODE=github
# PAGE2WEBMCP_GITHUB_APP_ID=
# PAGE2WEBMCP_GITHUB_PRIVATE_KEY_BASE64=
# PAGE2WEBMCP_GITHUB_REPOSITORY_BINDINGS=[{"owner":"example","repository":"project","repositoryId":1,"installationId":1,"ref":"refs/heads/main","targetOrigin":"https://app.example"}]
# PAGE2WEBMCP_GITHUB_SANDBOX_ORIGIN=https://sandbox.example
# PAGE2WEBMCP_GITHUB_SANDBOX_TOKEN=

# Use memory only for local fixture/demo execution. Production defaults to
# PostgreSQL and fails closed when DATABASE_URL is absent.
PAGE2WEBMCP_STORAGE_MODE=memory
DATABASE_URL=

# Required in production; generate distinct values of at least 32 characters
# and store them only in the deployment secret manager.
PAGE2WEBMCP_SESSION_SECRET=
PAGE2WEBMCP_OWNER_PASSWORD=
PAGE2WEBMCP_EDITOR_PASSWORD=

# Optional server-only observability. Generated/browser artifacts never contain
# these values. Vendor failures do not affect application outcomes.
PAGE2WEBMCP_OBSERVABILITY_ENABLED=false
PAGE2WEBMCP_OBSERVABILITY_ENVIRONMENT=local
PAGE2WEBMCP_OBSERVABILITY_RELEASE=

# Langfuse v5 tracing. Configure retention and residency in the vendor account.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# PostHog server events only; autocapture, profiles, and session replay are off.
POSTHOG_API_KEY=
POSTHOG_HOST=

# Optional port overrides allow concurrent Playwright runs.
PAGE2WEBMCP_E2E_CONTROL_PORT=3100
PAGE2WEBMCP_E2E_ACME_PORT=3200
