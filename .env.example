# Copy this file to .env before using non-local integrations. Never commit .env.
# Values below are intentionally non-secret placeholders.

# Runtime mode: local | live. Local mode uses the fully automated fixture adapters.
PAGE2WEBMCP_PROVIDER_MODE=local
PAGE2WEBMCP_TEST_SECRET=fixture-password

# Public deployment URLs and permitted cross-origin callers.
PAGE2WEBMCP_CONTROL_PLANE_URL=http://localhost:3100
PAGE2WEBMCP_FIXTURE_APP_URL=http://localhost:3200
PAGE2WEBMCP_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3200

# Supabase (required only for a live deployment; use server-only values outside browser code).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# GitHub App (required only for live GitHub-source analysis).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Browser Use or compatible remote-browser provider (live mode only).
BROWSER_USE_API_KEY=
BROWSER_USE_BASE_URL=
BROWSER_USE_PROJECT_ID=

# Optional asynchronous-worker queue (live mode only).
REDIS_URL=

# Deployment and release configuration. Keep deployment-provider tokens in their
# respective secret stores; these values identify the intended deployment only.
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
RENDER_SERVICE_ID=
PAGE2WEBMCP_RELEASE_ORIGIN=
