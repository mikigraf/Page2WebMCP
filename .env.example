# Page2WebMCP environment.
#
# Two ways to use this file:
#   cp .env.example .env.local   -> hermetic development (pnpm dev). Never live.
#   cp .env.example .env         -> a real production-live run (pnpm live:openapi
#                                   / pnpm live:website). Keep it mode 0600 and
#                                   never commit it.
#
# Every LIVE value below says where it comes from. Anything you cannot obtain
# honestly must stay unset: the preflight names what is missing and refuses to
# run rather than guessing.
#
# The commands load this file with Node's --env-file-if-exists=.env and print
# control NAMES only, never values.

# =============================================================================
# HERMETIC DEVELOPMENT (safe defaults; liveSuccess is always false)
# =============================================================================
# Acme is a test-only fixture and never counts as local-live or live.
PAGE2WEBMCP_PROVIDER_MODE=local
PAGE2WEBMCP_STORAGE_MODE=memory
PAGE2WEBMCP_FIXTURE_APP_URL=https://acme.example
PAGE2WEBMCP_FIXTURE_GITHUB_URL=https://github.com/acme/support
PAGE2WEBMCP_CONTROL_PLANE_URL=http://127.0.0.1:3100
PAGE2WEBMCP_CONTROL_PLANE_PUBLIC_ORIGIN=http://127.0.0.1:3100
PAGE2WEBMCP_DEMO_FIXTURE_URL=http://127.0.0.1:3200
PAGE2WEBMCP_ACME_PUBLIC_ORIGIN=http://127.0.0.1:3200
# Any 32+ character random string: openssl rand -hex 32
PAGE2WEBMCP_SESSION_SECRET=

# =============================================================================
# BEFORE A LIVE RUN — what you must already have
# =============================================================================
# 1. The hosted Supabase project (database + Storage bucket).
# 2. A deployed control plane and worker, built by `pnpm build:identity`.
# 3. A deployed release verifier          -> deploy/env/release-verifier.env.example
# 4. A deployed target website with a real HTTPS origin
#                                         -> deploy/env/example-target.env.example
# 5. Website journey only: a Browser Use Cloud account and the deployed website
#    gateway (three services)             -> deploy/env/website-gateway.env.example
#
# deploy/env/README.md lists every secret that must be byte-identical across
# these deployments. A mismatch fails closed, usually as an auth error.
#
# Do NOT set PAGE2WEBMCP_LOCAL_STACK or PAGE2WEBMCP_LOCAL_RELEASE_VERIFIER_ORIGIN
# in a live environment. The preflight rejects a live run when either is present,
# because they silently redirect Storage and the verifier to loopback.

# -----------------------------------------------------------------------------
# Provider selection. Exactly one real adapter per worker process.
# The UI still offers all three paths; one worker claims one source type.
# -----------------------------------------------------------------------------
# PAGE2WEBMCP_PROVIDER_MODE=openapi
# PAGE2WEBMCP_PROVIDER_MODE=website
# PAGE2WEBMCP_PROVIDER_MODE=github
# Live runs require durable persistence.
# PAGE2WEBMCP_STORAGE_MODE=postgres

# -----------------------------------------------------------------------------
# Deployment identity
# Where: `pnpm build:identity` prints these and bakes them into both images.
# The commit must be the exact clean commit you deployed; a live run also checks
# your working tree is clean and HEAD equals it.
# -----------------------------------------------------------------------------
# PAGE2WEBMCP_GIT_COMMIT_SHA=
# PAGE2WEBMCP_APPLICATION_RELEASE_ID=

# -----------------------------------------------------------------------------
# Database
# Where: Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the bounded login roles, never the owner or a superuser. Migrations create
# only the NOLOGIN application roles; create the hosted logins once by running
# deploy/sql/hosted-runtime-roles.sql (see docs/OPERATIONS.md "Hosted runtime
# logins"). The app and maintenance logins must be different roles; readiness
# audits that each is non-superuser, cannot bypass RLS, and does not inherit.
# Use the session pooler (port 5432). Pooler usernames are <login>.<project-ref>.
# Keep ?sslmode=verify-full; the images ship the Supabase root CA for it.
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://page2webmcp_app_hosted.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full
# PAGE2WEBMCP_MAINTENANCE_DATABASE_URL=postgresql://page2webmcp_maintenance_hosted.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full
# The worker's own login, if it runs as a separate process.
# PAGE2WEBMCP_WORKER_DATABASE_URL=postgresql://page2webmcp_worker_hosted.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full

# -----------------------------------------------------------------------------
# Application origin
# Where: the public HTTPS origin your control plane is deployed at. Exact origin,
# no path, no trailing slash. Must equal what was baked into the image.
# -----------------------------------------------------------------------------
# PAGE2WEBMCP_CONTROL_PLANE_PUBLIC_ORIGIN=https://control.example

# -----------------------------------------------------------------------------
# Hosted Supabase Storage — where published releases live
# Where: Supabase dashboard -> Project Settings -> API for the URL, and
# Project Settings -> API Keys -> service_role (secret) for the key.
# The secret key is server-only. Exposing it under any NEXT_PUBLIC_ name is
# blocked at startup. The bucket is the fixed public `page2webmcp-releases`, and
# every object key is exactly `<sha256>.js`.
# -----------------------------------------------------------------------------
# PAGE2WEBMCP_SUPABASE_URL=https://bimqgiedckdurqiywctl.supabase.co
# PAGE2WEBMCP_SUPABASE_SECRET_KEY=
# PAGE2WEBMCP_PUBLIC_ORIGIN=https://bimqgiedckdurqiywctl.supabase.co/storage/v1/object/public/page2webmcp-releases
# Browser-visible Supabase values (safe to expose; never the secret key).
# NEXT_PUBLIC_SUPABASE_URL=https://bimqgiedckdurqiywctl.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Release verifier
# Where: the HTTPS origin of your deployed verifier, and the token you set as
# PAGE2WEBMCP_RELEASE_VERIFIER_TOKEN in its environment. Both sides must match
# byte for byte; it signs and verifies every request and attestation.
# -----------------------------------------------------------------------------
# PAGE2WEBMCP_RELEASE_VERIFIER_ORIGIN=https://verifier.example
# PAGE2WEBMCP_RELEASE_VERIFIER_TOKEN=
# Local-live only. --live ignores it and refuses if it is present.
# PAGE2WEBMCP_LOCAL_RELEASE_VERIFIER_ORIGIN=http://127.0.0.1:3900

# -----------------------------------------------------------------------------
# Receipt signing
# Where: you generate it: openssl rand -hex 32. Keep it separate from the
# verifier token. It signs the live receipt so a holder cannot forge one by
# editing the file and recomputing the digest.
# -----------------------------------------------------------------------------
# PAGE2WEBMCP_RECEIPT_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Operator login
# Where: a file YOU create, mode 0600, owner-only, not a symlink, containing
# exactly {"email":"...","password":"..."} for a real user of your deployed
# control plane. The journey authenticates through the normal login API; it
# never inserts rows with SQL and never prints these values.
# -----------------------------------------------------------------------------
# PAGE2WEBMCP_OPERATOR_CREDENTIALS_FILE=/secure/page2webmcp-operator.json

# =============================================================================
# OPENAPI JOURNEY  (pnpm live:openapi -- --live)
# Needs nothing from Browser Use or the website gateway.
# =============================================================================
# The OpenAPI document to analyze. Must be HTTPS and reachable.
# Where: your target site, e.g. https://target.example/openapi.json
# PAGE2WEBMCP_E2E_SOURCE_URL=

# The site the generated module is bound to. Exact HTTPS origin, no path.
# Where: your deployed target website's public origin.
# PAGE2WEBMCP_OPENAPI_TARGET_ORIGIN=https://target.example

# A page on that site used as the same-origin test page.
# MUST be the same origin as PAGE2WEBMCP_OPENAPI_TARGET_ORIGIN.
# PAGE2WEBMCP_OPENAPI_TEST_PAGE_URL=https://target.example/

# The page where you install the <script> tag and that the verifier navigates to.
# MUST also be the same origin as the target origin.
# PAGE2WEBMCP_E2E_INSTALL_PAGE_URL=https://target.example/

# test | staging | production
# PAGE2WEBMCP_E2E_ENVIRONMENT=production

# =============================================================================
# WEBSITE / BROWSER USE JOURNEY  (pnpm live:website -- --live)
# Every key is required; partial setup fails closed before any browser starts.
# For this journey PAGE2WEBMCP_E2E_ENVIRONMENT must be exactly `production`, and
# PAGE2WEBMCP_E2E_INSTALL_PAGE_URL must be the same origin as
# PAGE2WEBMCP_E2E_SOURCE_URL (the site being explored).
# =============================================================================
# Browser Use Cloud key, format bu_...
# Where: https://cloud.browser-use.com -> API keys. This is the key the WORKER
# presents to YOUR gateway, so set the same value as the gateway's
# PAGE2WEBMCP_GATEWAY_BROWSER_USE_API_KEY. Your real upstream Browser Use key
# goes only in the gateway, as its ..._UPSTREAM_API_KEY.
# PAGE2WEBMCP_BROWSER_USE_API_KEY=

# Your deployed Browser Use gateway origin, NOT api.browser-use.com.
# Must differ from PAGE2WEBMCP_AUTH_HANDOFF_ORIGIN.
# PAGE2WEBMCP_BROWSER_USE_API_ORIGIN=https://browser-use-gateway.example

# The authentication handoff service: mints the portal URL a human logs in
# through. Its own deployment, on its own origin.
# PAGE2WEBMCP_AUTH_HANDOFF_ORIGIN=https://handoff.example
# PAGE2WEBMCP_AUTH_HANDOFF_TOKEN=

# The remaining seven controls are all served by the website gateway's "controls"
# deployment, so these origins are the same URL. Each token is a distinct random
# string you generate and mirror into the gateway env; a token for one control is
# never accepted on another control's route.
# PAGE2WEBMCP_BROWSER_LEASE_STORE_ORIGIN=https://controls.example
# PAGE2WEBMCP_BROWSER_LEASE_STORE_TOKEN=
# PAGE2WEBMCP_CDP_OBSERVER_ORIGIN=https://controls.example
# PAGE2WEBMCP_CDP_OBSERVER_TOKEN=
# PAGE2WEBMCP_EGRESS_POLICY_ORIGIN=https://controls.example
# PAGE2WEBMCP_EGRESS_POLICY_TOKEN=
# PAGE2WEBMCP_EGRESS_PROXY_ORIGIN=https://controls.example
# PAGE2WEBMCP_EGRESS_PROXY_TOKEN=
# PAGE2WEBMCP_EVIDENCE_STORE_ORIGIN=https://controls.example
# PAGE2WEBMCP_EVIDENCE_STORE_TOKEN=
# PAGE2WEBMCP_OWNERSHIP_STORE_ORIGIN=https://controls.example
# PAGE2WEBMCP_OWNERSHIP_STORE_TOKEN=
# PAGE2WEBMCP_SECRET_STORE_ORIGIN=https://controls.example
# PAGE2WEBMCP_SECRET_STORE_TOKEN=

# An opaque label, not a cloud KMS resource. The worker only ever sends its
# SHA-256, and it must equal the gateway's ..._SECRET_STORE_KMS_KEY_ID. The
# actual encryption happens inside the gateway under a root key you generate
# there with `openssl rand -base64 32`.
# PAGE2WEBMCP_SECRET_STORE_KMS_KEY_ID=page2webmcp-ttl-secrets-v1

# =============================================================================
# GITHUB PATH (not part of the two live journeys)
# Where: your GitHub App settings. Bind only explicitly selected repositories;
# the sandbox is mandatory, and no merge or fabricated PR path exists.
# =============================================================================
# PAGE2WEBMCP_GITHUB_APP_ID=
# PAGE2WEBMCP_GITHUB_PRIVATE_KEY_BASE64=
# PAGE2WEBMCP_GITHUB_REPOSITORY_BINDINGS=[{"owner":"example","repository":"project","repositoryId":1,"installationId":1,"ref":"refs/heads/main","targetOrigin":"https://app.example"}]
# PAGE2WEBMCP_GITHUB_SANDBOX_ORIGIN=
# PAGE2WEBMCP_GITHUB_SANDBOX_TOKEN=

# =============================================================================
# SET THIS ONLY AFTER THE FIRST RUN PUBLISHES A RELEASE
# The journey stops with INSTALLATION_ACTION_REQUIRED and prints the exact hash
# and script tag. Install the tag on your target page, set the value below, then
# re-run with --confirm-installed <hash>.
# =============================================================================
# PAGE2WEBMCP_READINESS_RELEASE_HASH=

# =============================================================================
# DOCKER LOCAL-LIVE (generated; never used for a live run)
# `pnpm local:up` writes these into the gitignored mode-0600 .page2webmcp/local.env.
# Do not copy the owner URL into a runtime process.
# =============================================================================
# PAGE2WEBMCP_LOCAL_STACK=true
# DATABASE_URL=<page2webmcp_app_local URL>
# PAGE2WEBMCP_WORKER_DATABASE_URL=<page2webmcp_worker_local URL>
# PAGE2WEBMCP_MAINTENANCE_DATABASE_URL=<page2webmcp_maintenance_local URL>
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:58321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# PAGE2WEBMCP_SUPABASE_URL=http://127.0.0.1:58321
# PAGE2WEBMCP_SUPABASE_SECRET_KEY=
# PAGE2WEBMCP_PUBLIC_ORIGIN=http://127.0.0.1:58321/storage/v1/object/public/page2webmcp-releases

# =============================================================================
# Optional server-only observability. These never enter generated code.
# =============================================================================
PAGE2WEBMCP_OBSERVABILITY_ENABLED=false
PAGE2WEBMCP_OBSERVABILITY_ENVIRONMENT=local
PAGE2WEBMCP_OBSERVABILITY_RELEASE=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
POSTHOG_API_KEY=
POSTHOG_HOST=

# Optional test port overrides.
PAGE2WEBMCP_E2E_CONTROL_PORT=3100
PAGE2WEBMCP_E2E_ACME_PORT=3200
