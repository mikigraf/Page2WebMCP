{
  "name": "page2webmcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 && node scripts/lint-source.mjs",
    "security:policy": "node scripts/check-source.mjs",
    "typecheck": "tsc --project tsconfig.base.json --noEmit",
    "test": "tsx --test test-support/**/*.test.ts apps/**/*.test.ts packages/**/*.test.ts",
    "test:golden": "tsx --test packages/evals/src/golden.test.ts",
    "test:e2e": "tsx --test e2e/**/*.test.ts && playwright test",
    "test:e2e:production": "pnpm build && pnpm test:e2e:production:built",
    "test:e2e:production:built": "tsx --test e2e/**/*.test.ts && PAGE2WEBMCP_E2E_PRODUCTION=true playwright test",
    "test:db:local": "bash scripts/test-rls-local.sh",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include='apps/**/app/**/*.ts' --test-coverage-include='apps/**/app/**/*.tsx' --test-coverage-include='apps/**/src/**/*.ts' --test-coverage-include='apps/**/src/**/*.tsx' --test-coverage-include='packages/**/src/**/*.ts' --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude='**/*.spec.ts' --test-coverage-exclude='**/tests/**' --test-coverage-exclude='**/*.d.ts' --test-coverage-lines=80 --test-coverage-functions=75 --test-coverage-branches=70 test-support/**/*.test.ts apps/**/*.test.ts packages/**/*.test.ts",
    "test:all": "pnpm lint && pnpm security:policy && pnpm typecheck && pnpm test:coverage && pnpm test:db:local && pnpm build && pnpm test:e2e:production:built",
    "demo:seed": "node scripts/demo-seed.mjs",
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "worker": "node --env-file-if-exists=.env.local .dist/worker/apps/worker/src/main.js",
    "build:identity": "node scripts/generate-deployment-identity.mjs",
    "build:identity:stage": "mkdir -p apps/control-plane/.dist && cp -f .dist/deployment-identity.json apps/control-plane/.dist/deployment-identity.json",
    "build:worker": "tsc --project tsconfig.worker.json",
    "build": "pnpm --filter @page2webmcp/acme-support build && pnpm --filter @page2webmcp/control-plane build && pnpm build:worker",
    "build:production-live": "pnpm build:identity && pnpm build:identity:stage && PAGE2WEBMCP_PRODUCTION_LIVE_BUILD=true pnpm build",
    "release:readiness": "tsx scripts/check-release-readiness.ts --hermetic",
    "live:preflight": "node --env-file-if-exists=.env --import=tsx scripts/check-production-live-preflight.ts",
    "live:openapi": "node --env-file-if-exists=.env --import=tsx scripts/run-production-live-journey.ts --provider openapi",
    "live:website": "node --env-file-if-exists=.env --import=tsx scripts/run-production-live-journey.ts --provider website",
    "local:up": "node scripts/local-supabase.mjs up",
    "local:reset": "node scripts/local-supabase.mjs reset",
    "local:status": "node scripts/local-supabase.mjs status",
    "local:down": "node scripts/local-supabase.mjs down",
    "dev:local-live": "node scripts/dev-local-live.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "supabase": "2.116.0",
    "tsx": "4.23.12"
  },
  "dependencies": {
    "@langfuse/otel": "5.11.0",
    "@langfuse/tracing": "5.11.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-node": "0.221.0",
    "@redocly/openapi-core": "2.45.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "next": "16.3.3",
    "pg": "8.23.0",
    "posthog-node": "5.51.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.2",
    "yaml": "2.9.0",
    "zod": "4.5.2"
  }
}
