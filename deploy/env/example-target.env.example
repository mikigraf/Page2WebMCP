# Example target website. This is the site Page2WebMCP analyzes, installs a
# release on, and the verifier navigates to. Deploy it at a real HTTPS origin
# that is not an acme host.

# This deployment's own exact public origin, no path and no trailing slash.
# Must match what you set as the journey's target origin and install page origin.
PAGE2WEBMCP_EXAMPLE_TARGET_PUBLIC_ORIGIN=https://target.example

# The login the human uses, and that the verifier's session cookies come from.
# The password is compared in constant time and never logged or rendered.
PAGE2WEBMCP_EXAMPLE_TARGET_OPERATOR_EMAIL=
PAGE2WEBMCP_EXAMPLE_TARGET_OPERATOR_PASSWORD=

# --- Set these only AFTER the first journey run publishes a release ---
# Until all three are valid the page renders
# <meta name="page2webmcp-status" content="release-unconfigured"> and installs nothing.
#
# The URL must be exactly the hosted Storage object for the hash below:
# https://bimqgiedckdurqiywctl.supabase.co/storage/v1/object/public/page2webmcp-releases/<hash>.js
# The control-plane /api/releases/<hash>.js route is rejected on purpose.
PAGE2WEBMCP_EXAMPLE_TARGET_RELEASE_URL=
# 64 lowercase hex characters, matching the filename above.
PAGE2WEBMCP_EXAMPLE_TARGET_RELEASE_CONTENT_HASH=
# sha384-<base64>, exactly as the journey returns it.
PAGE2WEBMCP_EXAMPLE_TARGET_RELEASE_INTEGRITY=
