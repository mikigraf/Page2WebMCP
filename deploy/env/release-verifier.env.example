# Release verifier service. Deploy behind TLS; the application reaches it at
# PAGE2WEBMCP_RELEASE_VERIFIER_ORIGIN. Never commit real values.

# --- Required. Startup fails listing any missing name. ---

# Must be byte-identical to the application's PAGE2WEBMCP_RELEASE_VERIFIER_TOKEN.
# 32-4096 characters. Signs and verifies every v2 request and attestation.
PAGE2WEBMCP_RELEASE_VERIFIER_TOKEN=

# Listen address and port inside the container.
PAGE2WEBMCP_RELEASE_VERIFIER_BIND_ADDRESS=0.0.0.0
PAGE2WEBMCP_RELEASE_VERIFIER_PORT=8080

# Comma-separated exact origins the verifier is allowed to navigate to.
# In a production-live run this is the example target's public origin.
PAGE2WEBMCP_RELEASE_VERIFIER_ALLOWED_TARGET_ORIGINS=https://target.example

# The application's public origin. Any request to it during tool execution is
# counted as forbidden traffic and fails the verification closed.
PAGE2WEBMCP_RELEASE_VERIFIER_CONTROL_PLANE_ORIGIN=https://control.example

# Run Chromium headless.
PAGE2WEBMCP_RELEASE_VERIFIER_BROWSER_HEADLESS=true

# Path to the durable replay log. An empty value keeps replay state in memory
# only, which forgets admitted request ids and nonces on restart.
PAGE2WEBMCP_RELEASE_VERIFIER_REPLAY_STORE_PATH=/var/lib/page2webmcp/replay.log

# --- Required in practice for execution evidence ---

# Session cookies for the target, as JSON. Applied only to the scope's origin,
# never logged, never present in an attestation. Without these the verifier
# cannot perform the authenticated read and evidence stays null.
# [{"name":"...","value":"...","domain":"target.example","path":"/"}]
PAGE2WEBMCP_RELEASE_VERIFIER_TARGET_SESSION_COOKIES=

# Which reviewed tools to call for the read, the confirmed reversible mutation,
# and the authoritative final-state read. {{marker}} is replaced with a fresh
# unique marker the final read must show.
# {"read":{"toolName":"...","input":{}},"mutation":{"toolName":"...","input":{"title":"{{marker}}"}},"finalState":{"toolName":"...","input":{}}}
PAGE2WEBMCP_RELEASE_VERIFIER_EXECUTION_PLAN=

# --- Optional ---

# Blink runtime features enabled at launch. Defaults to WebMCP when unset.
# WebMCP is still flagged in Chromium and is exposed only to a secure context;
# without it document.modelContext is absent and the honest observation is
# "not native", which the application refuses. Set to an empty value to launch
# with no extra features, or rename it as the feature ships unflagged.
# PAGE2WEBMCP_RELEASE_VERIFIER_BROWSER_BLINK_FEATURES=WebMCP

# live (default) or local_live.
# PAGE2WEBMCP_RELEASE_VERIFIER_MODE=live

# Allow http loopback targets. Leave unset in production.
# PAGE2WEBMCP_RELEASE_VERIFIER_ALLOW_LOOPBACK_TARGETS=

# Restrict which artifact origin may serve the module.
# PAGE2WEBMCP_RELEASE_VERIFIER_ARTIFACT_ORIGIN=

# Comma-separated deployment identity digests the verifier will answer for.
# PAGE2WEBMCP_RELEASE_VERIFIER_DEPLOYMENT_IDENTITY_DIGESTS=

# Extra origins counted as model traffic, beyond the built-in provider list.
# PAGE2WEBMCP_RELEASE_VERIFIER_MODEL_ORIGINS=

# PAGE2WEBMCP_RELEASE_VERIFIER_BROWSER_EXECUTABLE_PATH=
# PAGE2WEBMCP_RELEASE_VERIFIER_NAVIGATION_TIMEOUT_MS=30000
# PAGE2WEBMCP_RELEASE_VERIFIER_REQUEST_TIMEOUT_MS=55000
# PAGE2WEBMCP_RELEASE_VERIFIER_TOOL_TIMEOUT_MS=15000
# PAGE2WEBMCP_RELEASE_VERIFIER_MAX_ARTIFACT_BYTES=65536
# PAGE2WEBMCP_RELEASE_VERIFIER_MAX_RESPONSE_BYTES=262144
# PAGE2WEBMCP_RELEASE_VERIFIER_REPLAY_ENTRIES=4096
