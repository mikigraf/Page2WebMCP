# Website control gateway. This one service implements the nine control contracts
# the worker's Website / Browser Use path calls. It is needed ONLY for the Website
# journey; the OpenAPI journey does not use any of it.
#
# Deploy it THREE times from the same image with different PAGE2WEBMCP_GATEWAY_CONTROLS
# values, because the worker refuses a configuration where the auth-handoff origin
# equals the Browser Use origin. A control this process does not serve returns 404.
#
# There is no external KMS. The TTL secret store does its own envelope encryption
# under a root key you generate; the "KMS key id" is just an identifier string.

# --- Always required ---

# Which control families THIS process serves. Pick one of the three lines below.
#
# 1) controls origin
PAGE2WEBMCP_GATEWAY_CONTROLS=browser-lease-store,cdp-observer,egress-policy-store,egress-proxy,evidence-store,ownership-store,ttl-secret-store
# 2) auth-handoff origin
# PAGE2WEBMCP_GATEWAY_CONTROLS=authentication-handoff
# 3) browser-use origin
# PAGE2WEBMCP_GATEWAY_CONTROLS=browser-use-v4

PAGE2WEBMCP_GATEWAY_BIND_ADDRESS=0.0.0.0
PAGE2WEBMCP_GATEWAY_PORT=8080

# --- Required for the controls origin (deployment 1) ---
# Each is the inbound bearer this process accepts for that one control, and must
# equal the matching PAGE2WEBMCP_*_TOKEN in the application environment. Generate
# a distinct random value per control: a token for one control is never accepted
# on another control's route.
PAGE2WEBMCP_GATEWAY_BROWSER_LEASE_STORE_TOKEN=
PAGE2WEBMCP_GATEWAY_CDP_OBSERVER_TOKEN=
PAGE2WEBMCP_GATEWAY_EGRESS_POLICY_TOKEN=
PAGE2WEBMCP_GATEWAY_EGRESS_PROXY_TOKEN=
PAGE2WEBMCP_GATEWAY_EVIDENCE_STORE_TOKEN=
PAGE2WEBMCP_GATEWAY_OWNERSHIP_STORE_TOKEN=
PAGE2WEBMCP_GATEWAY_SECRET_STORE_TOKEN=

# TTL secret store. The key id is an opaque label; the worker only ever sends its
# SHA-256, and it must equal the application's PAGE2WEBMCP_SECRET_STORE_KMS_KEY_ID.
PAGE2WEBMCP_GATEWAY_SECRET_STORE_KMS_KEY_ID=page2webmcp-ttl-secrets-v1
# The root key that wraps each per-secret data key (AES-256-GCM). Base64 of 32
# random bytes, for example: openssl rand -base64 32
PAGE2WEBMCP_GATEWAY_SECRET_STORE_KMS_ROOT_KEY=

# --- Required for the auth-handoff origin (deployment 2) ---
# PAGE2WEBMCP_GATEWAY_AUTH_HANDOFF_TOKEN=
# The exact public HTTPS origin of THIS deployment; portal URLs are minted on it.
# PAGE2WEBMCP_GATEWAY_AUTH_HANDOFF_PUBLIC_ORIGIN=https://handoff.example

# --- Required for the browser-use origin (deployment 3) ---
# The credential the worker presents to this gateway. Must equal the application's
# PAGE2WEBMCP_BROWSER_USE_API_KEY. Format bu_...
# PAGE2WEBMCP_GATEWAY_BROWSER_USE_API_KEY=
# Your real Browser Use Cloud credential and origin, used for the upstream leg.
# Kept separate so the inbound key can be rotated independently.
# PAGE2WEBMCP_GATEWAY_BROWSER_USE_UPSTREAM_API_KEY=
# PAGE2WEBMCP_GATEWAY_BROWSER_USE_UPSTREAM_ORIGIN=https://api.browser-use.com

# --- Optional, must be supplied as a pair ---
# Lets the auth-handoff deployment terminate a provider session during cleanup.
# PAGE2WEBMCP_GATEWAY_BROWSER_USE_PEER_ORIGIN=
# PAGE2WEBMCP_GATEWAY_BROWSER_USE_PEER_API_KEY=
